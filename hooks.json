{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(write_to_file|WriteToFile|write_file|WriteFile|apply_patch|write|Write|edit|Edit|multi_edit|multiedit|MultiEdit|search_replace|SearchReplace|str_replace|StrReplace|replace_file_content|ReplaceFileContent)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook-runner.mjs\" FAIL_CLOSED none none node \"${PLUGIN_ROOT}/scripts/markdown_structure_guard.mjs\"",
            "timeout": 5,
            "statusMessage": "LazyArgon(1.0.0): Markdown Structure Guard",
            "failurePolicy": "FAIL_CLOSED"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook-runner.mjs\" FAIL_CLOSED none none node \"${PLUGIN_ROOT}/scripts/json_schema_guard.mjs\"",
            "timeout": 5,
            "statusMessage": "LazyArgon(1.0.0): JSON Schema Guard",
            "failurePolicy": "FAIL_CLOSED"
          }
        ]
      }
    ]
  }
}
