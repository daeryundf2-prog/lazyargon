{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/session_start.mjs",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(write_to_file|WriteToFile|write_file|WriteFile|edit_file|EditFile|apply_patch|write|Write|edit|Edit|multi_edit|multiedit|MultiEdit|multi_replace_file_content|MultiReplaceFileContent|search_replace|SearchReplace|str_replace|StrReplace|replace_file_content|ReplaceFileContent)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/write_chunk_guard.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(write_to_file|WriteToFile|write_file|WriteFile|edit_file|EditFile|apply_patch|write|Write|edit|Edit|multi_edit|multiedit|MultiEdit|multi_replace_file_content|MultiReplaceFileContent|search_replace|SearchReplace|str_replace|StrReplace|replace_file_content|ReplaceFileContent)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/post_tool_feedback.mjs wrap node ./scripts/markdown_structure_guard.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ./scripts/post_tool_feedback.mjs wrap node ./scripts/json_schema_guard.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/stop_claim_guard.mjs",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/post_tool_feedback.mjs inject",
        "timeout": 5
      }
    ]
  }
}
