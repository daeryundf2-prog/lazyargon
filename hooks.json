{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/session_start.mjs",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(write_to_file|WriteToFile|write_file|WriteFile|apply_patch|write|Write|edit|Edit|multi_edit|multiedit|MultiEdit|multi_replace_file_content|MultiReplaceFileContent|search_replace|SearchReplace|str_replace|StrReplace|replace_file_content|ReplaceFileContent)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hook-runner.mjs FAIL_CLOSED none none node ./scripts/markdown_structure_guard.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ./scripts/hook-runner.mjs FAIL_CLOSED none none node ./scripts/json_schema_guard.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
