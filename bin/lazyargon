#!/usr/bin/env node
/**
 * bin/lazyargon — Unified LazyArgon v2.0 CLI Entrypoint
 * Supports:
 *   lazyargon [tui] [--once] [--json] [--cwd <dir>]
 *   lazyargon radar <audit|list|poll> [--json]
 *   lazyargon doctor [--json] [--strict]
 */
import { spawnSync } from "node:child_process";
import { chmodSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const binPath = fileURLToPath(import.meta.url);
const root = join(dirname(binPath), "..");

try {
	chmodSync(binPath, 0o755);
} catch {
	// ignore read-only fs
}

const ROUTES = {
	tui: { runtime: process.execPath, script: "lazy_tui.mjs" },
	doctor: { runtime: process.execPath, script: "doctor.mjs" },
	radar: { runtime: process.execPath, script: "upstream_radar.mjs" },
	upstream: { runtime: process.execPath, script: "upstream_radar.mjs" },
	dag: { runtime: process.execPath, script: "dag_ulw.mjs" },
	codegraph: { runtime: process.execPath, script: "codegraph.mjs" },
	memory: { runtime: "python3", script: "lazy_memory.py" },
	rag: { runtime: "python3", script: "lazy_rag.py" },
	slop: { runtime: process.execPath, script: "lazy_slop_cleaner.mjs" },
	lsp: { runtime: process.execPath, script: "lsp_diagnostics.mjs" },
	calibrate: { runtime: process.execPath, script: "model_calibrate.mjs" },
	autoresearch: { runtime: process.execPath, script: "autoresearch_loop.mjs" },
};

const args = process.argv.slice(2);
const first = args[0] || "";
const isDefaultTui = !first || first.startsWith("-");
const sub = isDefaultTui ? "tui" : first;
const route = ROUTES[sub];

if (!route) {
	console.error(`Unknown lazyargon subcommand: ${sub}. Valid subcommands: ${Object.keys(ROUTES).join(", ")}`);
	process.exit(2);
}

const forwarded = isDefaultTui ? args : args.slice(1);
const res = spawnSync(route.runtime, [join(root, "scripts", route.script), ...forwarded], {
	stdio: "inherit",
	cwd: process.cwd(),
});

process.exit(res.status ?? 0);
