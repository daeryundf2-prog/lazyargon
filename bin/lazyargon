#!/usr/bin/env node
/**
 * bin/lazyargon — LazyArgon CLI entrypoint (active tools only).
 *   lazyargon doctor [--json] [--strict]
 *   lazyargon radar <audit|list|poll> [--json] [--remote] [--write]
 *   lazyargon codegraph <build|handoff|tests> ...
 *   lazyargon lsp <check|snapshot|verify|rename-preview> ...
 * Quarantined engines live in experimental/scripts/ and are run by path.
 */
import { spawnSync } from "node:child_process";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");

const ROUTES = {
	doctor: "doctor.mjs",
	radar: "upstream_radar.mjs",
	upstream: "upstream_radar.mjs",
	codegraph: "codegraph.mjs",
	lsp: "lsp_diagnostics.mjs",
};

const [sub = "doctor", ...forwarded] = process.argv.slice(2);
const script = ROUTES[sub];

if (!script) {
	console.error(`Unknown lazyargon subcommand: ${sub}. Valid subcommands: ${Object.keys(ROUTES).join(", ")}`);
	process.exit(2);
}

const res = spawnSync(process.execPath, [join(root, "scripts", script), ...forwarded], {
	stdio: "inherit",
	cwd: process.cwd(),
});

process.exit(res.status ?? 1);
